{
  "name": "dex-extension",
  "private": true,
  "version": "0.1.2",
  "description": "DEX Mini: crop, convert and resize images, and convert WebP and WebM downloads.",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build && wxt build -b firefox",
    "zip": "wxt zip && wxt zip -b firefox",
    "test": "vitest run",
    "check": "tsc --noEmit",
    "lint:firefox": "web-ext lint --source-dir .output/firefox-mv3",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.4"
  },
  "dependencies": {
    "gifenc": "^1.0.3",
    "mediabunny": "^1.62.0",
    "preact": "^11.0.1"
  }
}
